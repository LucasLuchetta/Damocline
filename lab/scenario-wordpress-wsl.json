{
  "name": "WordPress read-only publishing workflow on isolated Ubuntu WSL",
  "workload_revision": "wordpress-readonly-v1",
  "application_revision": "wordpress-7.1.3-php-8.1-apache-2.4-mariadb-10.6",
  "environment": "isolated-ubuntu-22.04-wsl2",
  "base_url": "http://127.0.0.1:8081",
  "mode": "closed",
  "users": 2,
  "duration": "30s",
  "ramp_up": "2s",
  "request_timeout": "5s",
  "max_rps": 10,
  "p95_limit_ms": 2500,
  "max_error_rate": 0.05,
  "min_samples_per_step": 10,
  "steps": [
    {
      "name": "browse_homepage",
      "method": "GET",
      "path": "/",
      "expected_status": [200]
    },
    {
      "name": "list_recent_posts",
      "method": "GET",
      "path": "/wp-json/wp/v2/posts?per_page=5",
      "expected_status": [200]
    }
  ]
}
