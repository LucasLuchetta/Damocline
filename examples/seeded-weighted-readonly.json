{
  "name": "Example seeded read-only workflows",
  "base_url": "https://app.example.com",
  "mode": "closed",
  "users": 10,
  "duration": "30s",
  "ramp_up": "5s",
  "request_timeout": "8s",
  "max_rps": 40,
  "p95_limit_ms": 1500,
  "max_error_rate": 0.01,
  "min_samples_per_step": 10,
  "workload_seed": 42,
  "think_time_range": {"min": "200ms", "max": "800ms"},
  "profiles": [
    {
      "name": "dashboard",
      "weight": 50,
      "steps": [
        {"name": "dashboard-page", "method": "GET", "path": "/dashboard", "expected_status": [200]},
        {"name": "dashboard-detail", "method": "GET", "path": "/dashboard/detail", "expected_status": [200]}
      ]
    },
    {
      "name": "search",
      "weight": 30,
      "think_time_range": {"min": "100ms", "max": "500ms"},
      "steps": [
        {"name": "search-page", "method": "GET", "path": "/search", "expected_status": [200]},
        {"name": "search-results", "method": "GET", "path": "/search/results", "expected_status": [200]}
      ]
    },
    {
      "name": "review",
      "weight": 20,
      "think_time": "400ms",
      "steps": [
        {"name": "review-list", "method": "GET", "path": "/records", "expected_status": [200]},
        {"name": "review-detail", "method": "GET", "path": "/records/example", "expected_status": [200]}
      ]
    }
  ]
}
